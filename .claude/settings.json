{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(cargo *)",
      "Bash(NO_DNA=1 cargo *)",
      "Bash(anchor *)",
      "Bash(NO_DNA=1 anchor *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(jq *)",
      "Bash(date *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(cut *)",
      "Bash(sha256sum *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(diff *)",
      "Bash(.agents/scripts/*)",
      "Bash(bash .agents/scripts/*)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*-key*.json)",
      "Write(**/*-key*.json)",
      "Edit(**/*-key*.json)",
      "Read(**/anchor/keys/**)",
      "Write(**/anchor/keys/**)",
      "Edit(**/anchor/keys/**)",
      "Read(~/.config/solana/**)",
      "Write(~/.config/solana/**)",
      "Edit(~/.config/solana/**)",
      "Read(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  }
}
